    "url": "https://github.com/solanabr/solana-iceberg/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p api/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "favicon": "node scripts/generate-favicon.mjs"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.7",
    "@stbr/solana-glossary": "^1.1.0",
    "@vercel/og": "^0.11.1",
