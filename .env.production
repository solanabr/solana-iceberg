# Absolute origin baked into canonical / og:url / og:image at build time.
# No trailing slash.
#
# Uses the www host because that is what the deployment actually serves:
# https://solanaiceberg.com 308-redirects to https://www.solanaiceberg.com.
# Pointing canonical and og:image through a redirect costs every crawler an
# extra hop and makes canonical non-self-referential. If you later make the
# apex primary in Vercel, change this line to match.
#
# Note: /api/meta derives its origin from the request Host header, so the
# rewritten routes (/, /t/:id, /l/:layer and their /pt and /es variants) are
# correct on any domain regardless of this value. This is the fallback for
# direct index.html hits and for dev.
VITE_SITE_URL=https://www.solanaiceberg.com
